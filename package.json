{
  "name": "dropify-mcp",
  "version": "0.1.1",
  "description": "Instant restock and drop alerts for official artist and brand merch stores. MCP server from Dropify.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dropify-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "manifest.json",
    "logo.png"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xozxro/dropify-mcp.git"
  },
  "homepage": "https://dropify.cloud",
  "bugs": {
    "url": "https://github.com/xozxro/dropify-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "merch",
    "restock-alerts",
    "music",
    "dropify"
  ],
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "test": "node --test-concurrency=2 --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
